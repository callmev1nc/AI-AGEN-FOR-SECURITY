# Supabase
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
DATABASE_URL=postgresql://postgres:your-password@your-project.supabase.co:5432/postgres

# Redis (Upstash or local — OPTIONAL)
# Scans work without Redis via the inline trigger API route.
# Set this if you want the BullMQ worker pipeline (requires Docker):
#   REDIS_URL=redis://localhost:6379
REDIS_URL=

# Upstash Redis (for rate limiting — OPTIONAL, uses REST API)
# Falls back to unlimited if not configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Anthropic (for AI features)
# ANTHROPIC_API_KEY=

# Stripe (for future billing integration)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
